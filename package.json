{
  "name": "moneytracker",
  "private": true,
  "version": "0.1.4",
  "description": "Plain-text double-entry bookkeeping for macOS: a hledger-compatible ledger with a fast capture window, rules, multi-currency and a rich dashboard.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "homepage": "https://github.com/lingfromSh/moneytracker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lingfromSh/moneytracker.git"
  },
  "bugs": {
    "url": "https://github.com/lingfromSh/moneytracker/issues"
  },
  "keywords": [
    "bookkeeping",
    "double-entry",
    "hledger",
    "plain-text-accounting",
    "ledger",
    "tauri",
    "macos",
    "finance",
    "multicurrency"
  ],
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bindings": "cargo run -p moneytracker --example export_bindings",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "d3-sankey": "^0.12.3",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^2.1.0",
    "recharts": "^3.2.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-sankey": "^0.12.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
